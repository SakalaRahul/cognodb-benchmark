# Copy this file to .env and fill in real values.
# NEVER commit the real .env file.

# --- CognoDB Cloud ---
COGNODB_URI=bolt+s://<instance-id>.databases.cognodb.cloud
COGNODB_USER=cognodb
COGNODB_PASSWORD=<paste-once-shown-password>

# --- Neo4j AuraDB Free ---
NEO4J_URI=neo4j+s://<instance-id>.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=<aura-generated-password>

TIGERGRAPH_HOST=https://<instance-id>.i.tgcloud.io
TIGERGRAPH_USER=<username>
TIGERGRAPH_SECRET=<secret_code>
TIGERGRAPH_GRAPH=SimpleIntGraph

# --- Memgraph (self-hosted docker, resource-capped) ---
MEMGRAPH_URI=bolt://localhost:7687
MEMGRAPH_USER=
MEMGRAPH_PASSWORD=

# --- ArangoDB (self-hosted docker, resource-capped) ---
ARANGO_URL=http://localhost:8529
ARANGO_USER=root
ARANGO_PASSWORD=changeme
ARANGO_DB=benchmark

# --- JanusGraph (self-hosted docker, resource-capped) ---
JANUSGRAPH_URL=ws://localhost:8182/gremlin

# --- Benchmark settings ---
WARMUP_ITERATIONS=20
MEASURED_ITERATIONS=100
RANDOM_SEED=42
