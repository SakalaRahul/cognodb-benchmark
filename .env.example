# Copy this file to .env and fill in real values.
# NEVER commit the real .env file.

# --- CognoDB Cloud ---
COGNODB_URI=bolt+s://<instance-id>.databases.cognodb.cloud
COGNODB_USER=cognodb
COGNODB_PASSWORD=<paste-once-shown-password>

# --- Neo4j AuraDB Free ---
NEO4J_URI=neo4j+s://<instance-id>.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=<aura-generated-password>

# --- ArangoDB Oasis ---
ARANGO_URL=https://<instance-id>.arangodb.cloud:8529
ARANGO_USER=root
ARANGO_PASSWORD=<oasis-password>
ARANGO_DB=benchmark

# --- FalkorDB Cloud ---
FALKORDB_HOST=<instance-host>.cloud
FALKORDB_PORT=<port>
FALKORDB_USER=falkordb
FALKORDB_PASSWORD=<falkordb-password>
FALKORDB_GRAPH=cognodb_benchmark

# --- TigerGraph Savanna ---
TIGERGRAPH_HOST=https://<workspace-id>.i.tgcloud.io
TIGERGRAPH_USER=<your-account-email>
TIGERGRAPH_SECRET=<secret-generated-in-admin-portal>
TIGERGRAPH_GRAPH=SimpleIntGraph

# --- Benchmark settings ---
WARMUP_ITERATIONS=5
MEASURED_ITERATIONS=30
RANDOM_SEED=42